# AI HUB — copy to .env for local development, then edit privately.
# Never commit .env or put real credentials in this example.
APP_USERNAME=
APP_PASSWORD=
ENABLE_API_DOCS=false

# Required for the seven active agents' NewsData retrieval. Keep secrets in the environment.
# News refresh is manual: passive reads never call the provider. Explicit refresh
# and each requested report checks fresh evidence; provider rate limits still apply.
NEWSDATA_API_KEY=
NEWSDATA_PLAN=unknown
# Range 1..50; unknown/free configuration caps pages at 10, configured paid at 50.
# Configuration is not proof of account entitlement. Live retrieval stops at
# 50 raw articles BEFORE deduplication/time/relevance filtering, or 90 seconds.
NEWSDATA_PAGE_SIZE=10
# Application daily NewsData-credit ceiling, separate from the provider quota and OpenAI USD.
# Integer >=0. The credit ledger is preserved; changing the setting does not erase usage.
NEWSDATA_DAILY_CREDIT_LIMIT=500

# OpenAI powers report analysis/translation, streamed chat and native web search.
# An explicit refresh may use bounded web discovery when NewsData is insufficient.
# Passive page loads, agent switching and timers never retrieve or generate.
# A funded OpenAI API account with model/tool access is required.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
MAX_OUTPUT_TOKENS=4096
# This setting is retained for older API clients. Native report
# research has fixed 8192-token discovery/synthesis output caps, <=6 native
# actions and <=40 inspected pages. NewsData retrieval is capped at 50 raw articles;
# analysis/translation have separate input/output and reservation bounds.
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=4096

# Pricing per 1 million tokens; checked against the model documentation 2026-10-19.
# Changing model requires matching model-specific pricing. Runtime fails closed on mismatch.
# OpenAI input estimates reserve an additional 1.25x for cache-write pricing.
OPENAI_PRICING_MODEL=gpt-6.1-sol
OPENAI_INPUT_USD_PER_MILLION=2
OPENAI_OUTPUT_USD_PER_MILLION=10

# Native web_search tool fee; search content tokens also incur model input charges.
# 10 USD/1,000 tool calls. The reservation covers every planned Responses stage.
# The result cap and native-action cap are independent. Unknown usage retains
# the upfront reservation; failed paid requests are not retried automatically.
OPENAI_WEB_SEARCH_PRICE_USD_PER_CALL=0.01

# Local durable state. On Render use /var/data/ai-hub/ai-hub.sqlite3 on the attached disk.
AI_HUB_DATABASE_PATH=./data/ai_hub.sqlite3

# Shared research attempt limit: reports, explicit feed web fallback, web-chat research and failed attempts.
# Calendar boundaries use Asia/Dubai. Configure 1..500 attempts/day; this is not a target.
# Without this variable, the application retains the fallback allowance of 50.
MAX_REPORTS_PER_DAY=500
# USD budgets are shared by report research, feed web discovery and chat.
# Ordinary local conversation does not consume the research attempt allowance.
# Each new web-research chat turn consumes one shared attempt; replay adds none.
# These are maximum shared app budget ceilings, NOT expected charges or invoices.
# The selected report path reserves bounded analysis/translation or native
# research before model calls, then reconciles complete known usage.
DAILY_BUDGET_USD=900
MONTHLY_BUDGET_USD=28000

# Durable jobs run in this one application process; do not add Uvicorn workers
# or Render instances while using SQLite on a single attached persistent disk.
REPORT_WORKER_ENABLED=true
REPORT_JOB_WORKERS=2
# Bounded queues accept deliberate requests while the workers are busy.
REPORT_MAX_ACTIVE_PER_OWNER=10
REPORT_MAX_ACTIVE_GLOBAL=50

# Keep false: retrieval and report generation are intentional user actions.
# Existing schedule records remain archived without automatic execution.
SCHEDULER_ENABLED=false
