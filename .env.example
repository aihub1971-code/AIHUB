# AI HUB — copy to .env for local development, then edit privately.
# Never commit .env or put real credentials in this example.
APP_USERNAME=
APP_PASSWORD=
ENABLE_API_DOCS=false

# Optional legacy adapter only. The 2.0 research workspace never uses NewsData.
# Keep an existing key only when supporting older authenticated API clients.
NEWSDATA_API_KEY=
NEWSDATA_PLAN=unknown
# Range 1..50; free plan at most 10/page. Each search considers the first 20
# provider results before validation; effective page size cannot exceed the remainder.
NEWSDATA_PAGE_SIZE=10
# Provider credits, separate from OpenAI USD; integer >=0. One latest page uses 1.
NEWSDATA_DAILY_CREDIT_LIMIT=200

# OpenAI powers all research workspace discovery, synthesis and connected chat.
# A funded OpenAI API account with model/tool access is required.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
MAX_OUTPUT_TOKENS=4096
# This setting is retained for older API clients. The 2.0 pipeline has fixed
# 8192-token discovery/synthesis output caps, <=6 native search/open/find actions,
# <=40 inspected pages and <=20 qualifying items AFTER validation/deduplication.
OPENAI_RESEARCH_MAX_OUTPUT_TOKENS=4096

# Pricing per 1 million tokens; checked against the model documentation 2026-10-19.
# Changing model requires matching model-specific pricing. Runtime fails closed on mismatch.
# OpenAI input estimates reserve an additional 1.25x for cache-write pricing.
OPENAI_PRICING_MODEL=gpt-6.1-sol
OPENAI_INPUT_USD_PER_MILLION=2
OPENAI_OUTPUT_USD_PER_MILLION=10

# Native web_search tool fee; search content tokens also incur model input charges.
# 10 USD/1,000 tool calls. The reservation covers every planned Responses stage.
# The result cap and native-action cap are independent. Unknown usage retains
# the upfront reservation; failed paid requests are not retried automatically.
OPENAI_WEB_SEARCH_PRICE_USD_PER_CALL=0.01

# Local durable state. On Render use /var/data/ai-hub/ai-hub.sqlite3 on the attached disk.
AI_HUB_DATABASE_PATH=./data/ai_hub.sqlite3

# Report-only attempt limit, including scheduled reports and unsuccessful attempts.
# Calendar boundaries use Asia/Dubai. Configure 1..100 attempts/day; this is not a target.
# Without this variable, the application retains the fallback allowance of 50.
MAX_REPORTS_PER_DAY=100
# USD budgets are shared by reports and chat; chat does not consume report attempts.
# These are maximum shared app budget ceilings, NOT expected charges or invoices.
# Six-action research reserves a conservative long-context upper estimate
# (up to ~16.08 USD for the default model/input caps), then reconciles known usage.
# The previous 5 USD daily limit cannot admit a new research job.
DAILY_BUDGET_USD=900
MONTHLY_BUDGET_USD=28000

# Durable jobs run in this one application process; do not add Uvicorn workers
# or Render instances while using SQLite on a single attached persistent disk.
REPORT_WORKER_ENABLED=true
REPORT_JOB_WORKERS=2

# Keep false until one live report has passed review.
# Each daily schedule must also be explicitly enabled in the app/API.
SCHEDULER_ENABLED=false
